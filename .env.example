# Copy this file to .env for local development.
# Never commit .env files with real credentials.

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/arthuila
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-app-password

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL_PUBLIC=http://localhost:3000

# Payments - ePayco
EPAYCO_PUBLIC_KEY=your-epayco-public-key
EPAYCO_PRIVATE_KEY=your-epayco-private-key
EPAYCO_P_CUST_ID=your-epayco-customer-id
EPAYCO_P_KEY=your-epayco-p-key
EPAYCO_TEST=true
EPAYCO_ALLOW_MOCK_PAYMENTS=true

# Logistics - MiPaquete
MIPAQUETE_API_KEY=your-mipaquete-api-key
MIPAQUETE_ORIGIN_CITY=your-origin-city-code
